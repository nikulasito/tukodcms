DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Route every event permalink through the CMS-driven detail page.
  RewriteRule ^events/([A-Za-z0-9-]+)/?$ events/view/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>
